<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omron_amr_capabilities</name>
  <version>0.1.0</version>
  <description>Execution plans and capabilities for Omron AMR navigation.</description>

  <maintainer email="kalanaratnayake95@gmail.com">Kalana Ratnayake</maintainer>
  <maintainer email="kalana.ratnayakemudiyanselage@canberra.edu.au">Kalana Ratnayake</maintainer>

  <author email="kalana.ratnayakemudiyanselage@canberra.edu.au">Kalana Ratnayake</author>
  <author email="kalanaratnayake95@gmail.com">Kalana Ratnayake</author>
  
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <exec_depend>capabilities2_server</exec_depend>
  <exec_depend>capabilities2_runner</exec_depend>
  <exec_depend>fabric_capabilities</exec_depend>
  <exec_depend>fabric_generator_prompttools</exec_depend>
  <exec_depend>fabric_parser_xml</exec_depend>
  <exec_depend>fabric_server</exec_depend>
  <exec_depend>fabric_validator</exec_depend>
  <exec_depend>nav2_capabilities</exec_depend>
  <exec_depend>prompt_bridge</exec_depend>
  <exec_depend>prompt_capabilities</exec_depend>
  <exec_depend>amr_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>

    <semantic_capability_interface>
      semantic_interfaces/AMRWaypointRunner.yaml
    </semantic_capability_interface>

    <semantic_capability_interface>
      semantic_interfaces/AMRRobotposeRunner.yaml
    </semantic_capability_interface>

    <capability_provider>
      providers/AMRNav2LaunchRunner.yaml
    </capability_provider>

    <capability_provider>
      providers/AMRWaypointRunner.yaml
    </capability_provider>

    <capability_provider>
      providers/AMRRobotposeRunner.yaml
    </capability_provider>

  </export>
</package>
